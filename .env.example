# Copy to .env and fill in from Supabase → Project Settings → API Keys.
#
# VITE_SUPABASE_ANON_KEY takes the PUBLISHABLE key. Depending on when your
# project was created it is either:
#   sb_publishable_xxxxxxxx   (new format)
#   eyJhbGciOi...             (older JWT format, labelled "anon public")
# Both work. It is meant to be public and ships inside the browser bundle.
#
# NEVER put the secret key here — sb_secret_... or the older "service_role"
# key. It bypasses every security rule in the database. Nothing in myRPS uses
# it. If one is ever pasted somewhere it shouldn't be, revoke it immediately in
# Project Settings → API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Must match app_settings.allowed_email_domain in the database.
VITE_ALLOWED_DOMAIN=studentmail.unimap.edu.my

# Your staff email. It appears on the signed-out page as a route for anyone
# locked out, so use the public university address, not a personal one.
#
# The WhatsApp number is NOT here on purpose: this bundle is public. Set it in
# Supabase → Table Editor → app_settings → rps_whatsapp instead, where only
# signed-in, approved students can read it.
VITE_RPS_EMAIL=zamrizahir@unimap.edu.my
VITE_RPS_NAME=Ts. Dr. Mohd Zamri bin Zahir Ahmad
